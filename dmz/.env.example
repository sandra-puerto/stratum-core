# ============================================================================
# STRATUM-CORE — dmz
# Repository: stratum-core
# Isolation by design, not by discipline.
# ============================================================================
#
# Component ......... dmz
# Artifact .......... .env.example
# Revision .......... 1.0.0
#
# ----------------------------------------------------------------------------
# 1. INSTRUCTIONS
# ----------------------------------------------------------------------------
#   1. Copy this file to `.env` in the same directory.
#   2. Populate each variable with the value required by the target
#      deployment environment.
#   3. Restrict file permissions: `chmod 600 .env`
#   4. Do not commit `.env` to version control. It is listed in .gitignore.
#
# ----------------------------------------------------------------------------
# 2. VARIABLES
# ----------------------------------------------------------------------------
#
# STRATUM_DMZ_NETWORK
#   Description ... Name of the shared Docker network (Demilitarized Zone).
#   Required ...... No. Default value applied if omitted.
#   Default ....... stratum_dmz
#   Constraint .... Must match the value configured in gateway/.env and
#                   database/.env.
#
# STRATUM_DMZ_SUBNET
#   Description ... IPv4 CIDR range assigned to the shared network.
#   Required ...... No. Default value applied if omitted.
#   Default ....... 172.16.0.0/24
#   Constraint .... Must not overlap with:
#                     - existing Docker networks on the host;
#                     - corporate VPN address ranges;
#                     - internal subnets declared by gateway or database.
#
# --- Image Version (Optional) -----------------------------------------------
ALPINE_IMAGE=alpine:3.20.3

# --- Shared Network Configuration -------------------------------------------
STRATUM_DMZ_NETWORK=stratum_dmz
STRATUM_DMZ_SUBNET=172.16.0.0/24