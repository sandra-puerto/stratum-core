# ============================================================================
# STRATUM-CORE — database
# Repository: stratum-core
# Isolation by design, not by discipline.
# ============================================================================
#
# Component ......... database
# Artifact .......... .env.example
# Revision .......... 1.1.0
#
# ----------------------------------------------------------------------------
# 1. INSTRUCTIONS
# ----------------------------------------------------------------------------
#   1. Copy this file to `.env` in the same directory.
#   2. Populate each variable with a strong, unique value. Passwords must
#      be generated with a cryptographically secure random source.
#   3. Restrict file permissions: `chmod 600 .env`
#   4. Do not commit `.env` to version control. It is listed in .gitignore.
#
# ----------------------------------------------------------------------------
# 2. VARIABLES
# ----------------------------------------------------------------------------
#
# MARIADB_ROOT_PASSWORD
#   Description ... Password for the MariaDB administrative account.
#   Required ...... Yes.
#   Handling ...... Sensitive. Never exposed to applications.
#
# MONGO_ROOT_USERNAME
#   Description ... Name of the MongoDB administrative account.
#   Required ...... Yes.
#
# MONGO_ROOT_PASSWORD
#   Description ... Password for the MongoDB administrative account.
#   Required ...... Yes.
#   Handling ...... Sensitive. Never exposed to applications.
#
# REDIS_PASSWORD
#   Description ... Authentication password for the Redis server.
#   Required ...... Yes.
#   Handling ...... Sensitive.
#
# STRATUM_DMZ_NETWORK
#   Description ... Name of the shared Docker network provisioned by dmz.
#   Required ...... No. Default value applied if omitted.
#   Default ....... stratum_dmz
#   Constraint .... Must match the value configured in dmz/.env and
#                   gateway/.env.
#
# TZ
#   Description ... Time zone for container logs and scheduled tasks.
#   Required ...... No. Default value applied if omitted.
#   Default ....... America/Bogota
#
# ----------------------------------------------------------------------------
# 3. NOTE ON APPLICATION ACCOUNTS
# ----------------------------------------------------------------------------
# This component provisions administrative accounts only. Application
# accounts must be created by the consuming application at deployment
# time, following the principle of least privilege. See ./README.md,
# section 5.4.
#
# --- Engine Images (Optional Version Overrides) -----------------------------
POSTGRES_IMAGE=postgres:16-alpine
MONGO_IMAGE=mongo:7.0
REDIS_IMAGE=redis:latest
NGINX_IMAGE=nginx:latest

# --- Relational Engine (PostgreSQL) ------------------------------------------
POSTGRES_PASSWORD=

# --- Document Store (MongoDB) -----------------------------------------------
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# --- Key-Value Engine (Redis) -----------------------------------------------
REDIS_PASSWORD=

# --- Platform ---------------------------------------------------------------
STRATUM_DMZ_NETWORK=stratum_dmz
TZ=America/Bogota