# ============================================================================
# STRATUM-CORE — gateway
# Repository: stratum-core
# Isolation by design, not by discipline.
# ============================================================================
#
# Component ......... gateway
# Artifact .......... .env.example
# Revision .......... 1.2.0
#
# ----------------------------------------------------------------------------
# 1. INSTRUCTIONS
# ----------------------------------------------------------------------------
#   1. Copy this file to `.env` in the same directory.
#   2. Populate each variable with the value required by the target
#      deployment environment.
#   3. Restrict file permissions: `chmod 600 .env`
#   4. Do not commit `.env` to version control. It is listed in .gitignore.
#
# ----------------------------------------------------------------------------
# 2. VARIABLES
# ----------------------------------------------------------------------------
#
# PRIMARY_ORG_NAME (Primary Organization Identifier)
#   Description ... Human-readable name or slug for the primary host organization
#                   (e.g., Isora).
#   Required ...... No. Defaults to 'primary'.
#
# SECONDARY_ORG_NAME (Secondary / Client Organization Identifier)
#   Description ... Human-readable name or slug for the secondary client organization
#                   (e.g., SandraPuerto).
#   Required ...... No. Defaults to 'secondary'.
#
# CF_TUNNEL_TOKEN (Primary Organization / Host Platform Tunnel)
#   Description ... Authentication token for the primary Cloudflare Tunnel.
#   Required ...... Yes.
#   Format ........ Opaque string issued by the Cloudflare Zero Trust
#                   dashboard when creating a named tunnel.
#   Handling ...... Sensitive. Treat as a credential. Rotate periodically.
#
# CF_TUNNEL_TOKEN_SECONDARY (Secondary / Client Organization Tunnel - Optional)
#   Description ... Authentication token for the secondary organization Cloudflare Tunnel.
#   Required ...... No. Activated when starting gateway with profile `secondary` or `multi-org`.
#
# COMPOSE_PROFILES
#   Description ... Active Docker Compose profiles to boot automatically.
#   Required ...... No. Set to `secondary` or `multi-org` to start both tunnels.
#
# STRATUM_DMZ_NETWORK
#   Description ... Name of the shared Docker network provisioned by the
#                   dmz component.
#   Required ...... No. Default value applied if omitted.
#   Default ....... stratum_dmz
#   Constraint .... Must match the value configured in dmz/.env and
#                   database/.env.
#
# TZ
#   Description ... Time zone for container logs and scheduled tasks.
#   Required ...... No. Default value applied if omitted.
#   Default ....... America/Bogota
#
# ============================================================================

# --- Organization Identifiers ---
PRIMARY_ORG_NAME=primary
SECONDARY_ORG_NAME=secondary

# --- Primary Cloudflare Tunnel (Required - Host Platform) ---
CF_TUNNEL_TOKEN=

# --- Secondary Cloudflare Tunnel (Optional - Client / Secondary Organization) ---
CF_TUNNEL_TOKEN_SECONDARY=

# --- Automated Profile Activation ---
# Set to 'secondary' to start the secondary organization tunnel automatically on 'docker compose up -d'
COMPOSE_PROFILES=

# --- Platform Networks & Locales ---
STRATUM_DMZ_NETWORK=stratum_dmz
TZ=America/Bogota