# ============================================================================
# STRATUM-CORE — gateway
# Repository: stratum-core
# Isolation by design, not by discipline.
# ============================================================================
#
# Component ......... gateway
# Artifact .......... .env.example
# Revision .......... 1.2.0
#
# ----------------------------------------------------------------------------
# 1. INSTRUCTIONS
# ----------------------------------------------------------------------------
#   1. Copy this file to `.env` in the same directory.
#   2. Populate each variable with the value required by the target
#      deployment environment.
#   3. Restrict file permissions: `chmod 600 .env`
#   4. Do not commit `.env` to version control. It is listed in .gitignore.
#
# ----------------------------------------------------------------------------
# 2. VARIABLES
# ----------------------------------------------------------------------------
#
# CF_TUNNEL_TOKEN (Primary Organization / Host Platform)
#   Description ... Authentication token for the primary Cloudflare Tunnel.
#   Required ...... Yes.
#   Format ........ Opaque string issued by the Cloudflare Zero Trust
#                   dashboard when creating a named tunnel.
#   Handling ...... Sensitive. Treat as a credential. Rotate periodically.
#
# CF_TUNNEL_TOKEN_ORG_A (Tenant A / Client Organization - Optional)
#   Description ... Authentication token for Tenant A Cloudflare Tunnel.
#   Required ...... No. Used when starting gateway with profile `org-a` or `all`.
#
# CF_TUNNEL_TOKEN_ORG_B (Tenant B / Client Organization - Optional)
#   Description ... Authentication token for Tenant B Cloudflare Tunnel.
#   Required ...... No. Used when starting gateway with profile `org-b` or `all`.
#
# COMPOSE_PROFILES
#   Description ... Active Docker Compose profiles to boot automatically.
#   Required ...... No. Example: `org-a` or `all`.
#
# STRATUM_DMZ_NETWORK
#   Description ... Name of the shared Docker network provisioned by the
#                   dmz component.
#   Required ...... No. Default value applied if omitted.
#   Default ....... stratum_dmz
#   Constraint .... Must match the value configured in dmz/.env and
#                   database/.env.
#
# TZ
#   Description ... Time zone for container logs and scheduled tasks.
#   Required ...... No. Default value applied if omitted.
#   Default ....... America/Bogota
#
# ============================================================================

# --- Primary Cloudflare Tunnel (Required - Host Platform e.g. domain.com) ---
CF_TUNNEL_TOKEN=

# --- Multi-Organization Tunnels (Optional - e.g. client-a.com / client-b.com) ---
CF_TUNNEL_TOKEN_ORG_A=
CF_TUNNEL_TOKEN_ORG_B=

# --- Automated Profile Activation (e.g. org-a or all) ---
# Set to 'org-a' or 'all' to start tenant tunnels automatically on 'docker compose up -d'
COMPOSE_PROFILES=

# --- Platform Networks & Locales ---
STRATUM_DMZ_NETWORK=stratum_dmz
TZ=America/Bogota